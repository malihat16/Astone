# Copy this file to .env for local development. Never commit .env.
# On Render, set the same variables under Environment.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
ALLOWED_HOSTS_DEPLOY=localhost,127.0.0.1,.onrender.com

# --- Database (Render gives you DATABASE_URL; docker-compose builds it from SQL_*) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname
SQL_NAME=astone_db
SQL_USER=astone
SQL_PASSWORD=change-me

# --- Frontend / CORS ---
FRONTEND_URL=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS_DEPLOY=http://localhost:5173,https://your-app.vercel.app
# Optional: allow Vercel preview URLs too
CORS_ALLOWED_ORIGIN_REGEXES=^https://your-app-.*\.vercel\.app$
CSRF_TRUSTED_ORIGINS_DEPLOY=http://localhost:8000,https://your-backend.onrender.com

# --- Admin account created by start.sh (local only) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# --- Email for password resets (leave blank to print emails to the console) ---
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# --- Optional: store product photos on Cloudinary instead of the server disk ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
